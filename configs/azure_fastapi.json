{
  "raw_data_dir": "../data/raw/metaQA",
  "processed_data_dir": "../data/metaQA",
  "hop": 1,
  "embedding_model": {
    "provider": "azure",
    "endpoint": "https://YOUR_AZURE_ENDPOINT.openai.azure.com",
    "api_key": "YOUR_AZURE_API_KEY",
    "api_version": "2024-05-01-preview",
    "deployment": "YOUR_EMBEDDING_DEPLOYMENT",
    "batch_size": 16
  },
  "vector_store_names": {
    "node": "metaQA_node",
    "relation": "metaQA_relation"
  },
  "retriever": {
    "node_sim_topk": 16,
    "relation_sim_topk": 16,
    "final_topk": 3,
    "timeout": 600
  },
  "llm": {
    "endpoint": "https://YOUR_AZURE_ENDPOINT.openai.azure.com",
    "api_key": "YOUR_AZURE_API_KEY",
    "api_version": "2024-05-01-preview",
    "deployment": "YOUR_GPT4_DEPLOYMENT",
    "model": "gpt-4",
    "temperature": 0.2,
    "top_p": 0.1,
    "max_tokens": 1024
  },
  "rewrite_shot": 12,
  "answer_shot": 12,
  "output_filename": "../results/metaQA_fastapi.txt"
}
